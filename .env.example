# Variables de entorno — turnos-odontología (desarrollo local / MVP)
# Copiar a `.env` con: cp .env.example .env
# NUNCA commitear el `.env` real ni secretos (R9).

# Postgres (servicio `postgres` en Compose; ver docker-compose.yml)
DATABASE_URL=postgresql+psycopg://turnos:turnos_dev@postgres:5432/turnos

# Redis / RQ (servicio `redis` en Compose)
REDIS_URL=redis://redis:6379/0

# Firma JWT — SOLO ejemplo local. Generar uno real por deploy (32+ bytes).
SECRET_KEY=cambiar-en-cada-deploy-32-bytes-minimo-0123456789abcdef

# Vida de tokens (minutos / días)
ACCESS_MINUTES=15
REFRESH_DAYS=7

# Tenant único de v1
TENANT_DEFAULT_SLUG=demo

# Zona horaria única del sistema (RN-GL-03) — no cambiar
TZ=America/Argentina/Buenos_Aires

# Origen del frontend para CORS (dev con Vite)
FRONTEND_ORIGIN=http://localhost:5173

# Ventana de recordatorios en horas, CSV (RN-CO-01; se parsea en C-11)
RECORDATORIO_VENTANA_HS=24,48

# URL base de la API para el frontend (Vite la lee como VITE_API_URL)
VITE_API_URL=http://localhost:8000
